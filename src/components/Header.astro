---
import Menu from "@icons/Menu.astro";
import { Image } from "astro:assets";
import type {HeaderProps} from "@types";
import LanguageSwitcher from "./LanguageSwitcher.astro";

type Props = Pick<HeaderProps, "siteLogoIcon" | "navLinks" >;

const { siteLogoIcon, navLinks } = Astro.props;
---

<header
    id="site-header"
    class="sticky top-0 z-50 flex w-full animate-slide-in justify-between bg-transparent px-6 lg:px-0 mx-auto max-w-4xl py-6 transition-colors duration-300"
>
  <a
      href="/"
      id="site-logo"
      aria-label="Home link"
      class="brightness-75 opacity-0 pointer-events-none transition-opacity duration-300 md:px-1.5"
  >
    <Image
        src={siteLogoIcon}
        width="45"
        height="45"
        alt="website logo"
        priority={true}
    />
  </a>
  <div class="flex flex-row gap-2">
    <!-- Button for navigation links (mobile view) -->
    <button
        type="button"
        id="menu-button"
        class="px-1.5 text-neutral sm:hidden"
        aria-expanded="false"
        aria-controls="main-menu"
    >
      <Menu />
    </button>
    <nav
        class="absolute top-20 right-5 hidden rounded-xl border border-neutral/40 bg-black px-4 py-5 text-neutral sm:static sm:block sm:border-0 sm:bg-transparent sm:p-0"
        id="main-menu"
    >
      <!-- Navigation links -->
      <ul class="relative gap-2 sm:flex">
        {
          navLinks.map((link) => (
              <li>
                <a
                    class="nav-item relative block p-2 text-sm font-medium transition-colors duration-300 hover:text-white"
                    href={link.href}
                >
                  {link.text}
                </a>
              </li>
          ))
        }
        <!-- Sliding active indicator line for sections -->
        <div
            id="nav-indicator"
            class="pointer-events-none absolute bottom-0 left-0 hidden h-0.5 bg-primary transition-all duration-300 ease-out sm:block opacity-0"
        />
      </ul>
    </nav>
    <LanguageSwitcher />
  </div>
  <script src="../scripts/headerObserver.ts"></script>
</header>