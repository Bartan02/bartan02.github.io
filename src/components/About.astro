---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { AboutProps, HeroProps } from "@types";

type Props = AboutProps & Pick<HeroProps, "name">;

const { description, image, name } = Astro.props;
---

<Section text="about" href="about">
  <div class="flex flex-col items-center gap-12 md:flex-row md:gap-8">
    <div class="flex flex-col gap-6">
      {description.map((paragraph, ) => (
          <p class="w-auto text-base text-neutral md:pr-5">{paragraph}</p>
      ))}
    </div>
    <div class="md:sticky md:top-1/2 md:-translate-y-1/2 md:shrink-0">
      <Image
          class="rounded-2xl"
          src={image}
          width="260"
          height="260"
          alt={name}
      />
    </div>
  </div>
</Section>
