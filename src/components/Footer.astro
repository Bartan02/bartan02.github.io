---
import type { SiteConfig } from "@types";

type Props = Pick<SiteConfig, "author" | "socialLinks" >;

const { author, socialLinks} = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer
  class="w-full flex flex-col gap-3 border-t border-neutral/20 px-5 pt-5 pb-8 text-center text-white"
>
  <ul class="mb-5 flex flex-wrap justify-center gap-x-5 text-xs">
    {
      socialLinks.map(({ text, href }) => (
        <li>
          <a
            href={href}
            target="_blank"
            class="inline-block px-4 py-3 hover:text-primary"
          >
            {text}
            <img
                src={`/icons/external.svg`}
                alt="Vercel"
                class="inline-block w-[1.2em] h-[1.2em] object-contain"
            />
          </a>
        </li>
      ))
    }
  </ul>
  <p class="text-xs">
    {author} © {currentYear}
  </p>
  <ul class="flex flex-wrap justify-center gap-x-5 text-[0.6rem]">
    <li class="flex items-center gap-1">
      Built with
      <img
          src={`/icons/stack/astro.svg`}
          alt="Astro Icon"
          class="inline-block w-[1.2em] h-[1.2em] object-contain"
      />
      Astro
    </li>
    <li class="flex items-center gap-1">
      Styled with
      <img
          src={`/icons/stack/tailwindcss.svg`}
          alt="TailwindCSS"
          class="inline-block w-[1.2em] h-[1.2em] object-contain"
      />
      TailwindCSS
    </li>
    <li class="flex items-center gap-1">
      Deployed on
      <img
          src={`/icons/stack/vercel.svg`}
          alt="Vercel"
          class="inline-block w-[1.2em] h-[1.2em] object-contain"
      />
      Vercel
    </li>
  </ul>
</footer>
